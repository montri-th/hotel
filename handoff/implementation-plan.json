  "acceptanceCriteria": [
    {
      "id": "A1",
      "scenario": "decode hotels.json",
      "expected": "30729 rows, nothing dropped, ids unique, alias row out",
      "verificationType": "unit (tests/data.test.js)"
    },
    {
      "id": "A2",
      "scenario": "publication hygiene",
      "expected": "no address, phone, raw record, private link; https sources only",
      "verificationType": "unit (tests/data.test.js, tests/release.test.js)"
    },
    {
      "id": "A3",
      "scenario": "rooms measure",
      "expected": "Σ rooms = 996784; unknown rooms never 0",
      "verificationType": "unit"
    },
    {
      "id": "A4",
      "scenario": "colour parity",
      "expected": "li.supply and count LUTs equal the LDS/LI source files",
      "verificationType": "script (npm run check:lds)"
    },
    {
      "id": "A5",
      "scenario": "first screen",
      "expected": "34% (44897/130608) in คลองเตย · ราชเทวี · วัฒนา; rail 19577/30071 vs 24305/64530",
      "verificationType": "unit (tests/insight.test.js) + render"
    },
    {
      "id": "A6",
      "scenario": "station panel",
      "expected": "hotels within 500 m with the radius drawn; link to CityMETER Transit",
      "verificationType": "unit (tests/views.test.js) + render"
    },
    {
      "id": "A7",
      "scenario": "comparison set",
      "expected": "same group, ½–2× rooms, ≤ 2 km, nearest first; never itself",
      "verificationType": "unit"
    },
    {
      "id": "A8",
      "scenario": "every view",
      "expected": "one provenance line + unit clause; Thai copy at 1440 and 390 px, light and dark",
      "verificationType": "unit + render"
    },
    {
      "id": "A9",
      "scenario": "live",
      "expected": "GitHub Pages serves the same bytes as main; walk in a real browser",
      "verificationType": "script (npm run verify:live) + live walk"
    },
    {
      "id": "A10",
      "scenario": "tie at the cut",
      "expected": "only districts strictly above the tie are the focus; all equal → spread",
      "verificationType": "unit (tests/insight.test.js)"
    },
    {
      "id": "A11",
      "scenario": "records measure in Phuket (3 districts)",
      "expected": "top 2 only: เมืองภูเก็ต · กะทู้ = 1886/2222; no rail line",
      "verificationType": "unit + render"
    },
    {
      "id": "A12",
      "scenario": "membership",
      "expected": "placed rows sit in a production district of their own province; admin counts match meta.counts",
      "verificationType": "unit (tests/data.test.js)"
    },
    {
      "id": "A13",
      "scenario": "hotel with a point",
      "expected": "eye preset (pitch 75) framed on its building or a 90 m box; ≤ 2 refits; MapLibre guard installed",
      "verificationType": "unit (tests/camera.test.js, tests/maplibre-guard.test.js) + render"
    },
    {
      "id": "A14",
      "scenario": "phone 390 px",
      "expected": "five toolbar buttons in one row; the Aha card sits above the legend (--legend-height); sheet readable in light and dark",
      "verificationType": "render + live walk"
    }
  ],
  "developerWorkflow": [
    "edit the research sheet, export .xlsx",
    "npm run build:data (see DATA_METHOD.md §10)",
    "npm test",
    "npm run check:lds -- --lds <base> --li <profile>",
    "bump ?v= tag + package.json + design-intent + handoff JSON",
    "push main",
    "npm run verify:live",
    "walk the live site at 1440 and 390 px, light and dark"
  ],
