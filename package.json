{
  "name": "citymeter-hotel",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "CityMETER · Hotel — district-first 3D map of recorded hotel rooms and accommodation records across Thailand, with rail and retail context from the same registry, hotel groups and a comparison set per hotel",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "python3 -m http.server 4173 --bind 127.0.0.1",
    "build:base": "python3 -I scripts/fetch-base.py --help",
    "build:boundaries": "python3 -I scripts/build-boundaries.py --help",
    "build:receipts": "python3 -I scripts/build-receipts.py --help",
    "build:data": "python3 -I scripts/build-data.py --help",
    "check:lds": "node scripts/check-lds-parity.mjs",
    "handoff:manifest": "node scripts/build-handoff.mjs",
    "handoff:bundle": "node scripts/build-handoff.mjs --zip dist/CityMETER-Hotel-Developer-Handoff.zip",
    "verify:live": "node scripts/verify-live.mjs",
    "build:logos": "python3 -I scripts/build-logos.py --help",
    "build:units": "python3 -I scripts/build-building-units.py --help"
  }
}
