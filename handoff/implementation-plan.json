{
  "$schema": "./handoff.schema.json",
  "schemaVersion": "1.5.0",
  "documentType": "implementation-plan",
  "productId": "citymeter-hotel",
  "productVersion": "0.1.0",
  "updatedOn": "2026-11-01",
  "architecture": {
    "runtime": "static site (GitHub Pages), ES modules with an import map, no build step; Node ≥ 20 for tests, Python 3 for data builds",
    "commands": {
      "test": "node --test tests/*.test.js",
      "start": "python3 -m http.server 4173 --bind 127.0.0.1",
      "build:base": "python3 -I scripts/fetch-base.py --help",
      "build:boundaries": "python3 -I scripts/build-boundaries.py --help",
      "build:receipts": "python3 -I scripts/build-receipts.py --help",
      "build:data": "python3 -I scripts/build-data.py --help",
      "check:lds": "node scripts/check-lds-parity.mjs",
      "handoff:manifest": "node scripts/build-handoff.mjs",
      "handoff:bundle": "node scripts/build-handoff.mjs --zip dist/CityMETER-Hotel-Developer-Handoff.zip",
      "verify:live": "node scripts/verify-live.mjs"
    },
    "libraries": {
      "maplibre": "MapLibre GL JS 5.6.2 (unpkg, pinned; js/maplibre-guard.js)",
      "earcut": "js/vendor/earcut.js (ISC)",
      "tiles": "OpenFreeMap planet (OpenMapTiles schema)"
    },
    "modules": {
      "js/app.js": "",
      "js/model.js": "",
      "js/areas.js": "",
      "js/area-insight.js": "",
      "js/profile-model.js": "",
      "js/panel.js": "",
      "js/charts.js": "",
      "js/chart-model.js": "",
      "js/map-layers.js": "",
      "js/provinces.js": "",
      "js/frames.js": "",
      "js/scales.js": "",
      "js/cues.js": "",
      "js/pins.js": "",
      "js/stations.js": "",
      "js/ask.js": "",
      "js/breadcrumb.js": "",
      "js/building-join.js": "",
      "js/massing.js": "",
      "js/camera.js": "",
      "js/venue-xray.js": "",
      "js/map-style.js": "",
      "js/maplibre-guard.js": "",
      "js/mvt.js": "",
      "js/geometry.js": "",
      "js/navigation.js": "",
      "js/vendors.js": "",
      "js/launch.js": ""
    },
    "data": [
      "data/hotels.json",
      "data/area-index.json",
      "data/frames/{CODE}.json",
      "data/provinces.geojson",
      "data/boundary-receipts.json"
    ]
  },
  "selection": {
    "filterFields": [
      "search",
      "group",
      "size",
      "province",
      "chain"
    ],
    "queryFields": [
      "metric",
      "area",
      "areas",
      "view",
      "hotel",
      "station",
      "view3d"
    ],
    "rowScopes": {
      "scopeRows": "rows after search · group · size · province · chain, before any district selection or focus: the comparison base of the Aha, the choropleth, the charts and every rank",
      "baseRows": "scopeRows narrowed by the selected เขต/อำเภอ",
      "rows": "baseRows narrowed by the district focus: pins with detail, counters, the table (a building or station panel shows its own rows)"
    },
    "panelActions": [
      "select-area",
      "select-hotel",
      "select-building",
      "select-station",
      "select-province",
      "filter-chain",
      "filter-group",
      "set-metric",
      "back",
      "explore-top",
      "clear-focus",
      "open-charts",
      "open-table",
      "clear-filter",
      "leave-area"
    ]
  },
